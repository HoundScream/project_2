+
+# Shared Claude API key used for the AI-assist cabinet endpoint. Can instead
+# be set via POST /admin/settings (that value wins if both are present).
+# Get a key from https://console.anthropic.com/ and a current model id from
+# https://docs.claude.com/en/docs/about-claude/models (do not guess one).
+CLAUDE_API_KEY=
+CLAUDE_MODEL=
+
+# Bearer token required by /admin/settings. Generate a long random value
+# (e.g. `openssl rand -hex 32`); leave unset to disable the admin panel.
+ADMIN_TOKEN=
+
+# Optional: enables POST .../organizations/lookup (company search by name/INN).
+# Get a key from https://dadata.ru/.
+DADATA_API_KEY=
